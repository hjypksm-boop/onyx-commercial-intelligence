# Leave DATABASE_URL empty to use the bundled SQLite file data/onyx.db.
# PostgreSQL / Supabase example: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# Groq (Meta Llama). The app works fully without a key (template fallback).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Demo clock. Empty = the date the database is seeded. Format YYYY-MM-DD.
AS_OF_DATE=
